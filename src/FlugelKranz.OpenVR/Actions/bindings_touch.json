{
  "controller_type": "oculus_touch",
  "name": "FlugelKranz explicit buttons",
  "bindings": {
    "/actions/flight": {
      "sources": [
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/flight/in/left_drag"
            }
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/flight/in/left_turn"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/flight/in/right_drag"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/flight/in/right_turn"
            }
          }
        }
      ]
    }
  },
  "app_key": "org.flugelkranz.windows",
  "description": "Hold grip (Touch) or trigger (Index) to drag; hold X/A to turn. Customize in SteamVR."
}
