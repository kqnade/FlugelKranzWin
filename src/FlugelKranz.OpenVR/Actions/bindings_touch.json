{
  "description": "FlugelKranz default controls",
  "controller_type": "oculus_touch",
  "name": "FlugelKranz",
  "bindings": {
    "/actions/flight": {
      "sources": [
        {
          "path": "/user/hand/left/input/thumbrest",
          "mode": "button",
          "inputs": {
            "touch": {
              "output": "/actions/flight/in/left_thumbrest"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": {
            "touch": {
              "output": "/actions/flight/in/left_trigger"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbrest",
          "mode": "button",
          "inputs": {
            "touch": {
              "output": "/actions/flight/in/right_thumbrest"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": {
            "touch": {
              "output": "/actions/flight/in/right_trigger"
            }
          }
        }
      ],
      "poses": [
        {
          "output": "/actions/flight/in/left_pose",
          "path": "/user/hand/left/pose/raw"
        },
        {
          "output": "/actions/flight/in/right_pose",
          "path": "/user/hand/right/pose/raw"
        }
      ]
    }
  }
}
