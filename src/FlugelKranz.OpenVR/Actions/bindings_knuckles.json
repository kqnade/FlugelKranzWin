{
  "controller_type": "knuckles",
  "name": "FlugelKranz explicit buttons",
  "bindings": {
    "/actions/flight": {
      "sources": [
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/flight/in/left_drag"
            }
          }
        },
        {
          "path": "/user/hand/left/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/flight/in/left_turn"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/flight/in/right_drag"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/flight/in/right_turn"
            }
          }
        }
      ]
    },
    "/actions/pilot": {
      "sources": [
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/pilot/in/thrust"
            }
          }
        },
        {
          "path": "/user/hand/left/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/pilot/in/left_toggle"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/pilot/in/right_toggle"
            }
          }
        }
      ]
    }
  },
  "app_key": "org.flugelkranz.windows",
  "description": "Drag: grip (Touch) / trigger (Index). X/A: Turn normally; short press toggles head pilot and long press resets inertia in experimental mode. Left stick Y: thrust."
}
