<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FlugelKranz</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EmbeddedResource Include="../../LICENSE;../../THIRD-PARTY-NOTICES.txt;../../WINDOWS.md;../../README.md;../../UPSTREAM.md"
                      LogicalName="Package/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../FlugelKranz.OpenVR/Vendor/LICENSE-OpenVR" LogicalName="Package/LICENSE-OpenVR" />
    <EmbeddedResource Include="$(DriverPackageDirectory)/**/*" Condition="'$(DriverPackageDirectory)' != ''"
                      LogicalName="Package/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Native NuGet packages ship external PDBs; managed symbols are embedded by the build script. -->
  <Target Name="ExcludeSingleFileNativeSymbols" AfterTargets="ComputeFilesToPublish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="FlugelKranz.Tests" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../WINDOWS.md" Link="WINDOWS.md" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\FlugelKranz.OpenXR\FlugelKranz.OpenXR.csproj" />
    <ProjectReference Include="..\FlugelKranz.OpenVR\FlugelKranz.OpenVR.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <None Update="../../LICENSE;../../THIRD-PARTY-NOTICES.txt;../../WINDOWS.md" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Markup.Declarative" Version="12.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
